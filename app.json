    "version": "0.4.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.soukideals.app",
      "supportsTablet": false
    },
    "android": {
      "package": "fr.soukideals.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1650"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Souki Deals utilise l'appareil photo pour scanner les bons de réduction des clients en caisse."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Souki Deals utilise votre position pour afficher les commerces halal les plus proches."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "supabaseUrl": "https://rczotdgtkwfbnrbvyjon.supabase.co",
      "supabasePublishableKey": "sb_publishable_WuIm_jhdaazGAXPQK5tq-w_Rb-PUE1i",
      "eas": {
        "projectId": "ca9a0853-76f5-42ce-bc71-850f008dae6c"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4A1650"
    },
    "owner": "sacko-dembas-team"
  }
}
